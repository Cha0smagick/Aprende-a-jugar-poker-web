---
---
<script>
  // This component will be enhanced with Vue for interactivity
  // For now, it's a static Astro component
</script>

<header class="h-16 md:h-14">
  <div class="container-wide h-full flex items-center justify-between gap-4">
    <!-- Logo / Brand -->
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="Poker Mastery - Inicio">
      <svg class="w-8 h-8 text-poker-gold" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="currentColor"/>
        <path d="M8 12h16M8 16h12M8 20h8" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span class="font-display font-bold text-heading-lg text-text-primary hidden sm:block">Poker Mastery</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Navegación principal">
      <a href="/curso" class="px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg transition-colors">
        Curso
      </a>
      <a href="/herramientas" class="px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg transition-colors">
        Herramientas
      </a>
      <a href="/diplomas" class="px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg transition-colors">
        Diplomas
      </a>
      <a href="/comunidad" class="px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg transition-colors">
        Comunidad
      </a>
    </nav>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-2 shrink-0">
      <!-- Search Button -->
      <button
        id="search-toggle"
        class="p-2 text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg transition-colors"
        aria-label="Buscar (Ctrl+K)"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <kbd class="hidden lg:inline-flex items-center gap-1 px-1.5 py-0.5 text-xs bg-bg-tertiary rounded text-text-muted font-mono">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/></svg>
          K
        </kbd>
      </button>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="p-2 text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg transition-colors"
        aria-label="Cambiar tema"
        aria-pressed="false"
      >
        <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
      </button>

      <!-- User Menu / Login -->
      <div id="user-menu-container" class="relative">
        <button
          id="user-menu-trigger"
          class="flex items-center gap-2 px-3 py-1.5 bg-bg-tertiary rounded-lg hover:bg-bg-hover transition-colors"
          aria-label="Menú de usuario"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-poker-gold to-poker-gold-light flex items-center justify-center">
            <span class="text-xs font-bold text-poker-black" id="user-initial">U</span>
          </div>
          <span class="hidden sm:block text-sm font-medium text-text-primary" id="user-name">Usuario</span>
          <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <div
          id="user-menu-dropdown"
          class="dropdown-content hidden right-0 mt-1 min-w-[240px]"
          role="menu"
          aria-orientation="vertical"
        >
          <div class="px-4 py-3 border-b border-border-default">
            <p class="font-medium text-text-primary" id="dropdown-user-name">Usuario</p>
            <p class="text-sm text-text-muted" id="dropdown-user-email">usuario@email.com</p>
          </div>

          <a href="/progreso" class="dropdown-item flex items-center gap-2" role="menuitem">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Mi Progreso
          </a>
          <a href="/diplomas" class="dropdown-item flex items-center gap-2" role="menuitem">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Mis Diplomas
          </a>
          <a href="/configuracion" class="dropdown-item flex items-center gap-2" role="menuitem">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Configuración
          </a>

          <hr class="border-border-default my-1" />

          <button id="logout-btn" class="dropdown-item flex items-center gap-2 text-error" role="menuitem">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Cerrar sesión
          </button>
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-bg-secondary border-t border-border-default animate-slide-down"
    role="navigation"
    aria-label="Menú móvil"
  >
    <nav class="px-4 py-3 space-y-1">
      <a href="/curso" class="block px-3 py-2.5 text-base font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg">Curso</a>
      <a href="/herramientas" class="block px-3 py-2.5 text-base font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg">Herramientas</a>
      <a href="/diplomas" class="block px-3 py-2.5 text-base font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg">Diplomas</a>
      <a href="/comunidad" class="block px-3 py-2.5 text-base font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg">Comunidad</a>
      <hr class="border-border-default my-2" />
      <a href="/progreso" class="block px-3 py-2.5 text-base font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg">Mi Progreso</a>
      <a href="/configuracion" class="block px-3 py-2.5 text-base font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary rounded-lg">Configuración</a>
    </nav>
  </div>

  <!-- Search Modal -->
  <div
    id="search-modal"
    class="fixed inset-0 z-modal hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-modal-title"
  >
    <div class="modal-backdrop" aria-hidden="true"></div>
    <div class="modal-content max-w-2xl w-full mx-4 mt-20">
      <div class="p-4 border-b border-border-default flex items-center gap-3">
        <h2 id="search-modal-title" class="font-display font-semibold text-heading-lg">Buscar en el curso</h2>
        <button id="search-close" class="ml-auto p-1 text-text-muted hover:text-text-primary rounded-lg hover:bg-bg-tertiary" aria-label="Cerrar búsqueda">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="p-4">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input
            type="search"
            id="search-input"
            class="w-full pl-10 pr-4 py-3 bg-bg-tertiary border border-border-default rounded-lg text-text-primary placeholder-text-muted focus:border-border-focus focus:ring-2 focus:ring-border-focus/20 focus:outline-none"
            placeholder="Escribe para buscar lecciones, conceptos, fórmulas..."
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="Búsqueda"
          />
        </div>
        <div id="search-results" class="mt-4 space-y-2 max-h-[60vh] overflow-y-auto scrollbar-thin" role="list" aria-label="Resultados de búsqueda">
          <p class="text-text-muted text-center py-8" id="search-empty">Empieza a escribir para buscar...</p>
        </div>
        <div class="mt-4 pt-4 border-t border-border-default flex items-center justify-between text-sm text-text-muted">
          <kbd class="px-2 py-1 bg-bg-tertiary rounded">Esc</kbd> para cerrar · <kbd class="px-2 py-1 bg-bg-tertiary rounded">↑↓</kbd> navegar · <kbd class="px-2 py-1 bg-bg-tertiary rounded">Enter</kbd> seleccionar
        </div>
      </div>
    </div>
  </div>
</header>