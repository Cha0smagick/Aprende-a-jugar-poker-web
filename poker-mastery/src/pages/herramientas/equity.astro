---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import EquityCalculator from '@/components/interactive/EquityCalculator.vue';
---

<BaseLayout title="Equity Calculator - Poker Mastery" description="Calculadora de equity Monte Carlo + enumeración exacta. Range vs Range, heatmaps, multiway. Gratis, offline." canonical="/herramientas/equity">
  <Header slot="header" />
  <Footer slot="footer" />

  <main class="min-h-screen">
    <section class="relative section-lg overflow-hidden">
      <div class="container-wide relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-poker-felt/10 border border-poker-felt/20 rounded-full text-sm font-medium text-poker-felt mb-6">
          <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-poker-felt opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-poker-felt"></span></span>
          Herramienta Profesional · Gratis · Offline
        </div>
        <h1 class="font-display font-bold text-display-xl md:text-display-lg text-text-primary mb-4">Equity Calculator</h1>
        <p class="text-body-lg text-text-secondary mb-8 max-w-2xl mx-auto">Monte Carlo (1M+ iteraciones) + enumeración exacta. Range vs Range, heatmaps de equity, análisis multiway. La misma calculadora que usan los pros.</p>
      </div>
    </section>

    <section class="section">
      <div class="container-wide">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div class="lg:col-span-2">
            <div class="card p-6">
              <EquityCalculator client:load />
            </div>
          </div>

          <div class="space-y-6">
            <div class="card p-6">
              <h3 class="font-display font-semibold text-heading-lg text-text-primary mb-4">Cómo usar</h3>
              <ul class="space-y-3 text-text-secondary">
                <li class="flex items-center gap-2"><span class="w-2 h-2 bg-poker-gold rounded-full"></span> Define rangos para cada jugador (sintaxis: 22+, A2s+, KTs+)</li>
                <li class="flex items-center gap-2"><span class="w-2 h-2 bg-poker-gold rounded-full"></span> Añade cartas del board (flop, turn, river)</li>
                <li class="flex items-center gap-2"><span class="w-2 h-2 bg-poker-gold rounded-full"></span> Selecciona modo: Monte Carlo (rápido) o Exacto (preciso)</li>
                <li class="flex items-center gap-2"><span class="w-2 h-2 bg-poker-gold rounded-full"></span> Haz clic en "Calcular" y analiza resultados</li>
              </ul>
            </div>

            <div class="card p-6">
              <h3 class="font-display font-semibold text-heading-lg text-text-primary mb-4">Notación de Rangos</h3>
              <div class="grid grid-cols-2 gap-2 text-sm text-text-secondary">
                <span><strong>22+</strong> = Todas parejas</span>
                <span><strong>A2s+</strong> = Ases suited</span>
                <span><strong>ATo+</strong> = Ases offsuit</span>
                <span><strong>KTs+</strong> = Reyes suited</span>
                <span><strong>QJs</strong> = Específico suited</span>
                <span><strong>AKo</strong> = Específico offsuit</span>
                <span><strong>T9s-54s</strong> = Rango conectores</span>
                <span><strong>22-66</strong> = Rango parejas</span>
              </div>
            </div>

            <div class="card p-6">
              <h3 class="font-display font-semibold text-heading-lg text-text-primary mb-4">Métricas Clave</h3>
              <dl class="space-y-3 text-text-secondary">
                <dt class="font-medium">Equity</dt><dd class="text-sm">% de ganar el bote en showdown</dd>
                <dt class="font-medium">Equity Realization</dt><dd class="text-sm">Equity ajustada por posición y jugabilidad</dd>
                <dt class="font-medium">Nuts %</dt><dd class="text-sm">Frecuencia de hacer la mejor mano posible</dd>
                <dt class="font-medium">EV</dt><dd class="text-sm">Expected Value en bb/100</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-bg-secondary border-y border-border-default">
      <div class="container-wide text-center">
        <h2 class="font-display font-bold text-display-sm text-text-primary mb-4">Más Herramientas</h2>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/herramientas/pot-odds" class="btn-secondary">Pot Odds / MDF</a>
          <a href="/herramientas/icm" class="btn-secondary">ICM Calculator</a>
          <a href="/herramientas/range-builder" class="btn-secondary">Range Builder</a>
          <a href="/herramientas/trainers" class="btn-secondary">Trainers</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>