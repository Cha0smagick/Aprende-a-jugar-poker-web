---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

const MODULES = [
  { id: 4, title: 'Posiciones y Rangos Base', lessons: 12, duration: '6h', icon: '🎯', status: 'disponible', route: '/curso/fase-1/modulo-4' },
  { id: 5, title: 'Open Raising Strategy', lessons: 10, duration: '5h', icon: '📈', status: 'pronto', route: null },
  { id: 6, title: '3-Betting: Teoría y Práctica', lessons: 10, duration: '5h', icon: '⚔️', status: 'pronto', route: null },
  { id: 7, title: '4-Betting y Cold 4-Betting', lessons: 6, duration: '3h', icon: '💥', status: 'pronto', route: null },
  { id: 8, title: 'Blind Defense & Stealing', lessons: 8, duration: '4h', icon: '🛡️', status: 'pronto', route: null },
];
---

<BaseLayout title="Fase 1: Maestría Preflop - Poker Mastery" description="Rangos sólidos, posiciones, 3-bet, 4-bet, defense y steal. La base de todo juego ganador." canonical="/curso/fase-1">
  <Header slot="header" />
  <Footer slot="footer" />

  <main class="min-h-screen">
    <section class="relative section-lg overflow-hidden">
      <div class="container-wide relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-poker-felt/10 border border-poker-felt/20 rounded-full text-sm font-medium text-poker-felt mb-6">
            🔵 Fase 1 · Maestría Preflop · 46 lecciones · 23h
          </div>
          <h1 class="font-display font-bold text-display-xl md:text-display-lg text-text-primary mb-6">
            Fase 1: Maestría Preflop
          </h1>
          <p class="text-body-lg text-text-secondary mb-10 max-w-2xl mx-auto">
            Construye rangos de acero por posición. Domina open raising, 3-bet, 4-bet, cold calls, blind defense y steals. La base de todo juego ganador.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
            <div class="card p-4">
              <div class="text-3xl font-display font-bold text-poker-gold">5</div>
              <div class="text-sm text-text-muted">Módulos</div>
            </div>
            <div class="card p-4">
              <div class="text-3xl font-display font-bold text-poker-gold">46</div>
              <div class="text-sm text-text-muted">Lecciones</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-bg-secondary border-y border-border-default">
      <div class="container-wide">
        <header class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="font-display font-bold text-display-sm text-text-primary mb-4">Módulos de la Fase 1</h2>
        </header>

        <div class="space-y-4">
          {MODULES.map((m) => (
            <a href={m.route || '#'} class={`card p-5 md:p-6 flex flex-col md:flex-row md:items-center gap-4 group border ${m.status === 'disponible' ? 'border-l-4 border-l-poker-felt hover:border-poker-felt/50' : 'border-border-default hover:border-border-default'}`}>
              <div class="w-10 h-10 rounded-xl bg-bg-tertiary flex items-center justify-center text-xl font-mono font-bold text-text-primary">
                {m.icon}
              </div>
              <div class="flex-1">
                <h3 class="font-semibold text-heading-md text-text-primary">{m.title}</h3>
                <div class="flex items-center gap-3 text-xs text-text-muted mt-1">
                  <span>{m.lessons} lecciones</span>
                  <span>•</span>
                  <span>{m.duration}</span>
                </div>
              </div>
              <span class={`badge ${m.status === 'disponible' ? 'bg-success text-white' : 'bg-bg-tertiary text-text-muted'}`}>
                {m.status === 'disponible' ? 'Disponible' : 'Próximamente'}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <div class="text-center section">
      <div class="container-wide">
        <p class="text-text-muted mb-4">Los módulos 5-8 están en desarrollo y estarán disponibles pronto.</p>
        <a href="/curso" class="btn-secondary btn-lg">Volver al Currículo</a>
      </div>
    </div>
  </main>
</BaseLayout>
